# Copiar a ~/CampusSeguro/campus.properties y llenar con los datos reales.
# Ese archivo no se sube a GitHub. Las variables de entorno con el mismo
# nombre tienen prioridad sobre este archivo.

# API del manager de Wazuh (puerto 55000, no el dashboard)
WAZUH_API_URL=https://SERVIDOR_WAZUH:55000
WAZUH_API_USER=usuario_de_consulta
WAZUH_API_PASSWORD=secreto
